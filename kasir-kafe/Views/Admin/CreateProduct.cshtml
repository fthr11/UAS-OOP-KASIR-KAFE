@model kasirkafe.Models.Product

@{
    ViewData["Title"] = "Tambah Produk";
}

<h2>Tambah Produk</h2>

<form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label>Nama Produk</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Gambar Produk</label>
        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Harga</label>
        <input asp-for="Price" class="form-control" type="number" />
    </div>

    <div class="form-group">
        <label>Kategori</label>
        <input asp-for="Category" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Simpan</button>
    <a asp-action="ManageProduct" class="btn btn-secondary mt-3">Kembali</a>
</form>

