@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Kasir Kafe</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">

    <style>
        @@import url('https://fonts.googleapis.com/css?family=Karla:400,700&display=swap');

        .font-family-karla {
            font-family: karla;
        }
    </style>
</head>

<body class="bg-white font-family-karla h-screen">

    <div class="w-full flex flex-wrap">

        <!-- Register Section -->
        <div class="w-full md:w-1/2 flex flex-col">

            <div class="flex justify-center md:justify-start pt-12 md:pl-12 md:-mb-12">
                <a href="#" class="bg-yellow-500 text-white font-bold text-xl p-4" alt="Logo">PNJ</a>
            </div>

            <div class="flex flex-col justify-center md:justify-start my-auto pt-8 md:pt-0 px-8 md:px-24 lg:px-32">
                <p class="text-center text-3xl">Silahkan daftar terlebih dahulu.</p>

                <!-- FORM REGISTER -->
                <form asp-action="Register" asp-controller="Auth" method="post" class="flex flex-col pt-3 md:pt-8">

                    <div class="flex flex-col pt-4">
                        <label class="text-lg">Name</label>
                        <input type="text" name="Name" placeholder="John Smith"
                            class="shadow border rounded w-full py-2 px-3 mt-1 text-gray-700 focus:outline-none">
                    </div>

                    <div class="flex flex-col pt-4">
                        <label class="text-lg">Email</label>
                        <input type="email" name="Email" placeholder="your@email.com"
                            class="shadow border rounded w-full py-2 px-3 mt-1 text-gray-700 focus:outline-none">
                    </div>

                    <div class="flex flex-col pt-4">
                        <label class="text-lg">Password</label>
                        <input type="password" name="Password" placeholder="Password"
                            class="shadow border rounded w-full py-2 px-3 mt-1 text-gray-700 focus:outline-none">
                    </div>

                    <div class="flex flex-col pt-4">
                        <label class="text-lg">Confirm Password</label>
                        <input type="password" name="ConfirmPassword" placeholder="Confirm Password"
                            class="shadow border rounded w-full py-2 px-3 mt-1 text-gray-700 focus:outline-none">
                    </div>

                    <button type="submit" class="bg-black text-white font-bold text-lg hover:bg-gray-700 p-2 mt-8">
                        Register
                    </button>
                </form>

                <div class="text-center pt-12 pb-12">
                    <p>Already have an account?
                        <a asp-action="Login" asp-controller="Auth" class="underline font-semibold">Log in here.</a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Image Section -->
        <div class="w-1/2 shadow-2xl">
            <img class="object-cover w-full h-screen hidden md:block"
                src="https://images.pexels.com/photos/2396220/pexels-photo-2396220.jpeg?cs=srgb&dl=pexels-tyler-nix-1259808-2396220.jpg&fm=jpg" alt="Background">
        </div>
    </div>

</body>

</html>